# Ring app credentials, issued once when the app is created in the Ring
# Developer Portal. The client ID and secret are used to exchange and
# refresh account-linking tokens.
RING_CLIENT_ID=
RING_CLIENT_SECRET=

# Passcode the household enters on Prism's Account Link page (/ring/link),
# the sign-in step Ring requires before linking a Ring account. Account
# linking stays disabled until this is set.
RING_LINK_PASSCODE=

# Optional fixed access token for Ring API calls (device names, event
# snapshots), used instead of a linked account's tokens. Generate one in the
# Ring Developer Playground -- it's valid for about 30 minutes -- and check
# it with `npm run ring:devices`.
RING_ACCESS_TOKEN=
# Ring Partner API base URL. Optional; defaults to https://api.amazonvision.com.
RING_API_BASE_URL=

# The app's HMAC signing key. Ring signs webhooks with it (X-Signature) and
# computes account-linking nonces with it. The local event simulator
# (`npm run seed`) signs with the same value; `npm run init-env` generates
# one if this is empty, which is enough for the simulator.
RING_WEBHOOK_SECRET=

# Bedrock Runtime region and model id used for multimodal classification.
# AWS credentials themselves come from the standard SDK provider chain
# (environment, shared config, or an IAM role) -- not from this file.
BEDROCK_REGION=us-east-2
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock embedding model used for repeat-visitor memory (src/bedrock/embeddings.ts).
# Dimensions must match the vector(N) column in db/migrations/0005_event_embeddings.sql.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Repeat-visitor session memory tuning (src/db/vectorStore.ts). All optional;
# defaults shown. Measure before changing the thresholds:
# `npm run eval:repeat --workspace=prism-backend`.
SESSION_WINDOW_MINUTES=45
REPEAT_VISITOR_SIMILARITY_THRESHOLD=0.60
REPEAT_VISITOR_IMAGE_SIMILARITY_THRESHOLD=0.92

# Optional image matching for repeat-visitor memory: set to a Bedrock
# multimodal embedding model (e.g. amazon.titan-embed-image-v1) enabled for
# your account. Leave empty to match on the visitor signature only.
# BEDROCK_IMAGE_EMBEDDING_REGION defaults to BEDROCK_REGION.
BEDROCK_IMAGE_EMBEDDING_MODEL_ID=
BEDROCK_IMAGE_EMBEDDING_REGION=

DATABASE_URL=postgres://prism:prism@localhost:5433/prism
PORT=3000

# VAPID key pair for Web Push. `npm run init-env` generates a pair if both
# are empty (or use `npx web-push generate-vapid-keys`).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL push services may use to reach the sender, e.g. mailto:ops@example.com.
VAPID_SUBJECT=

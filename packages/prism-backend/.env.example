# Ring Partner API credentials issued for this integration.
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REDIRECT_URI=http://localhost:3000/auth/ring/callback

# Account Link URL and Token Exchange URL issued for this partner integration.
RING_AUTHORIZE_URL=
RING_TOKEN_URL=

# Optional. Only set this if the partner agreement specifies an OAuth scope.
RING_OAUTH_SCOPE=

# Shared secret Ring signs webhook payloads with (HMAC-SHA256).
RING_WEBHOOK_SECRET=

# Bedrock Runtime region and model id used for multimodal classification.
# AWS credentials themselves come from the standard SDK provider chain
# (environment, shared config, or an IAM role) -- not from this file.
BEDROCK_REGION=
BEDROCK_MODEL_ID=

DATABASE_URL=postgres://prism:prism@localhost:5432/prism
PORT=3000

# VAPID key pair for Web Push (generate with `npx web-push generate-vapid-keys`).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URL push services may use to reach the sender, e.g. mailto:ops@example.com.
VAPID_SUBJECT=
